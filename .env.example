# Core database
DATABASE_URL="postgresql://postgres:replace-with-password@db.replace-with-project-ref.supabase.co:5432/postgres?sslmode=no-verify"
DIRECT_URL="postgresql://postgres:replace-with-password@db.replace-with-project-ref.supabase.co:5432/postgres?sslmode=require"

# App URLs and auth
# En Vercel reemplazá con: https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL="https://tu-proyecto.vercel.app"
NEXTAUTH_URL="https://tu-proyecto.vercel.app"
NEXTAUTH_SECRET="replace-with-random-secret"
AUTH_SECRET="replace-with-random-secret"

# Admin seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-strong-password"

# Public store
NEXT_PUBLIC_STORE_NAME="Tienda de Ropa"
NEXT_PUBLIC_STORE_DESCRIPTION="Tienda de ropa con ecommerce, POS y checkout por WhatsApp."
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"
NEXT_PUBLIC_CURRENCY="ARS"

# Cloudinary
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"

# Supabase Auth / client
SUPABASE_API_URL="https://replace-with-project-ref.supabase.co/rest/v1/"
NEXT_PUBLIC_SUPABASE_URL="https://replace-with-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_PUBLIC_API_KEY="replace-with-publishable-key"
SUPABASE_SECRET_API_KEY="replace-with-secret-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Google OAuth
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_SECRET="replace-with-google-client-secret"

# Mercado Pago Checkout Pro
MERCADO_PAGO_ENV="sandbox"
MERCADO_PAGO_ACCESS_TOKEN="replace-with-mp-access-token"
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="replace-with-mp-public-key"
MERCADO_PAGO_WEBHOOK_SECRET="replace-with-mp-webhook-secret"
# En Vercel estas URLs se actualizan solas con NEXT_PUBLIC_APP_URL
MERCADO_PAGO_SUCCESS_URL="https://tu-proyecto.vercel.app/checkout/success"
MERCADO_PAGO_FAILURE_URL="https://tu-proyecto.vercel.app/checkout/failure"
MERCADO_PAGO_PENDING_URL="https://tu-proyecto.vercel.app/checkout/pending"

# Andreani
ANDREANI_ENV="sandbox"
ANDREANI_API_URL="replace-with-andreani-api-url"
ANDREANI_CLIENT_ID="replace-with-andreani-client-id"
ANDREANI_CLIENT_SECRET="replace-with-andreani-client-secret"
ANDREANI_CONTRACT_NUMBER="replace-with-andreani-contract-number"

# Local delivery / POS
LOCAL_COURIER_ENABLED="true"
LOCAL_COURIER_FIXED_COST="0"
POS_CARD_SURCHARGE_PERCENT="20"
POS_RECEIPT_WIDTH_MM="80"