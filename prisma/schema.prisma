generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductKind {
  APPAREL
  FOOTWEAR
}

model User {
  id                 String                @id @default(cuid())
  name               String?
  email              String                @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String
  role               String                @default("owner")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  accounts           Account[]
  sessions           Session[]
  auditLogs          AuditLog[]            @relation("AuditActor")
  stockMovements     StockMovement[]       @relation("StockMovementCreatedBy")
  openedCashSessions CashRegisterSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashRegisterSession[] @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]        @relation("CashMovementCreatedBy")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([order])
}

model Product {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  description        String
  kind               ProductKind      @default(APPAREL)
  brand              String?
  material           String?
  careInstructions   String?
  priceCents         Int
  stock              Int              @default(0)
  sku                String?          @unique
  featured           Boolean          @default(false)
  status             ProductStatus    @default(DRAFT)
  defaultWeightGrams Int?
  defaultHeightCm    Decimal?         @db.Decimal(8, 2)
  defaultWidthCm     Decimal?         @db.Decimal(8, 2)
  defaultLengthCm    Decimal?         @db.Decimal(8, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  stockMovements     StockMovement[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id        String   @id @default(cuid())
  alt       String?
  url       String
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroBanner {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  ctaLabel      String?
  ctaHref       String?
  imageUrl      String
  imagePublicId String?
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@index([active])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Sale {
  id               String                @id @default(cuid())
  channel          SalesChannel          @default(POS)
  customerId       String?
  customer         Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSessionId    String?
  cashSession      CashRegisterSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  customerName     String?
  customerPhone    String?
  deliveryMethod   String?
  notes            String?
  totalCents       Int
  subtotal         Decimal?              @db.Decimal(12, 2)
  discountTotal    Decimal?              @db.Decimal(12, 2)
  surchargeTotal   Decimal?              @db.Decimal(12, 2)
  costTotal        Decimal?              @db.Decimal(12, 2)
  status           SaleStatus            @default(PENDING)
  paymentMethod    String                @default("CASH") // CASH, TRANSFER, MIXED
  paidWithCash     Int?                  @default(0) // Part paid in cash
  paidWithTransfer Int?                  @default(0) // Part paid in transfer
  amountReceived   Int?                  @default(0) // How much cash was physically received (to calculate change)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            SaleItem[]
  payments         Payment[]
  stockMovements   StockMovement[]
  ledgerEntries    CustomerLedgerEntry[]
  cashMovements    CashMovement[]
  receipts         InternalReceipt[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([cashSessionId])
  @@index([channel, createdAt])
}

model SaleItem {
  id           String          @id @default(cuid())
  saleId       String
  sale         Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String?
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  internalSku  String?
  variantLabel String?
  name         String
  priceCents   Int
  unitCost     Decimal?        @db.Decimal(12, 2)
  quantity     Int

  @@index([saleId])
  @@index([variantId])
  @@index([internalSku])
}

enum SalesChannel {
  WEB
  POS
  ADMIN
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  IN_PREPARATION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  IN_PROCESS
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  MERCADO_PAGO
  CURRENT_ACCOUNT
  MIXED
}

enum PaymentProvider {
  INTERNAL
  MERCADO_PAGO
}

enum ShipmentProvider {
  ANDREANI
  LOCAL_COURIER
  PICKUP
  MANUAL
}

enum ShipmentStatus {
  QUOTED
  PENDING_LABEL
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum StockMovementType {
  INITIAL
  SALE
  ORDER_PAID
  PURCHASE_RECEIPT
  ADJUSTMENT
  RETURN
  CANCELLED_ORDER
  TRANSFER
}

enum CustomerLedgerEntryType {
  DEBIT
  CREDIT
  ADJUSTMENT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  PAYMENT_IN
  WITHDRAWAL
  EXPENSE
  ADJUSTMENT
  CLOSING_DIFFERENCE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InternalReceiptType {
  SALE
  DEBT_PAYMENT
  PURCHASE_ORDER
  ADJUSTMENT
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  internalSku        String              @unique
  size               String
  colorName          String
  colorHex           String?
  price              Decimal             @db.Decimal(12, 2)
  cost               Decimal             @default(0) @db.Decimal(12, 2)
  stock              Int                 @default(0)
  stockReserved      Int                 @default(0)
  weightGrams        Int?
  heightCm           Decimal?            @db.Decimal(8, 2)
  widthCm            Decimal?            @db.Decimal(8, 2)
  lengthCm           Decimal?            @db.Decimal(8, 2)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([productId, size, colorName])
  @@index([productId, active])
  @@index([size])
  @@index([colorName])
}

model Customer {
  id              String                @id @default(cuid())
  name            String
  phone           String                @unique
  email           String?
  document        String?
  debtAccumulated Decimal               @default(0) @db.Decimal(12, 2)
  creditLimit     Decimal               @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  addresses       CustomerAddress[]
  orders          Order[]
  sales           Sale[]
  payments        Payment[]
  ledgerEntries   CustomerLedgerEntry[]
  receipts        InternalReceipt[]

  @@index([name])
  @@index([createdAt])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipientName String?
  phone         String?
  street        String
  streetNumber  String?
  apartment     String?
  city          String
  province      String
  postalCode    String
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([customerId])
  @@index([postalCode])
}

model Order {
  id                 String                    @id @default(cuid())
  orderNumber        String                    @unique
  channel            SalesChannel              @default(WEB)
  status             OrderStatus               @default(DRAFT)
  customerId         String?
  customer           Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddressId  String?
  shippingAddress    CustomerAddress?          @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  customerEmail      String?
  subtotal           Decimal                   @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal                   @default(0) @db.Decimal(12, 2)
  shippingTotal      Decimal                   @default(0) @db.Decimal(12, 2)
  surchargeTotal     Decimal                   @default(0) @db.Decimal(12, 2)
  total              Decimal                   @default(0) @db.Decimal(12, 2)
  currency           String                    @default("ARS")
  paymentStatus      PaymentStatus             @default(PENDING)
  shippingPostalCode String?
  externalReference  String?                   @unique
  notes              String?
  paidAt             DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  items              OrderItem[]
  payments           Payment[]
  shipments          Shipment[]
  stockMovements     StockMovement[]
  webhookEvents      MercadoPagoWebhookEvent[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId])
  @@index([shippingAddressId])
  @@index([channel, createdAt])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name          String
  variantLabel  String?
  internalSku   String?
  quantity      Int
  unitPrice     Decimal         @db.Decimal(12, 2)
  unitCost      Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([internalSku])
}

model Payment {
  id                String                @id @default(cuid())
  orderId           String?
  order             Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  saleId            String?
  sale              Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  method            PaymentMethod
  provider          PaymentProvider       @default(INTERNAL)
  status            PaymentStatus         @default(PENDING)
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("ARS")
  externalPaymentId String?               @unique
  externalReference String?
  installments      Int?
  rawPayload        Json?
  paidAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  ledgerEntries     CustomerLedgerEntry[]

  @@index([orderId])
  @@index([saleId])
  @@index([customerId])
  @@index([provider, status])
  @@index([method, createdAt])
}

model MercadoPagoWebhookEvent {
  id              String    @id @default(cuid())
  eventKey        String    @unique
  resourceId      String?
  topic           String?
  action          String?
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  signature       String?
  rawPayload      Json
  processedAt     DateTime?
  processingError String?
  receivedAt      DateTime  @default(now())

  @@index([resourceId])
  @@index([processedAt])
}

model Shipment {
  id              String           @id @default(cuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        ShipmentProvider
  status          ShipmentStatus   @default(QUOTED)
  quotedCost      Decimal?         @db.Decimal(12, 2)
  chargedCost     Decimal?         @db.Decimal(12, 2)
  trackingNumber  String?
  labelUrl        String?
  labelPublicId   String?
  postalCode      String?
  city            String?
  addressLine     String?
  providerPayload Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([orderId])
  @@index([provider, status])
  @@index([trackingNumber])
}

model ShippingZone {
  id             String           @id @default(cuid())
  name           String
  provider       ShipmentProvider @default(LOCAL_COURIER)
  city           String?
  postalCodeFrom String?
  postalCodeTo   String?
  fixedCost      Decimal          @default(0) @db.Decimal(12, 2)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([provider, active])
  @@index([city])
}

model StockMovement {
  id                     String            @id @default(cuid())
  variantId              String
  variant                ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productId              String
  product                Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type                   StockMovementType
  quantity               Int
  stockBefore            Int
  stockAfter             Int
  unitCost               Decimal?          @db.Decimal(12, 2)
  relatedOrderId         String?
  relatedOrder           Order?            @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedSaleId          String?
  relatedSale            Sale?             @relation(fields: [relatedSaleId], references: [id], onDelete: SetNull)
  relatedPurchaseOrderId String?
  relatedPurchaseOrder   PurchaseOrder?    @relation(fields: [relatedPurchaseOrderId], references: [id], onDelete: SetNull)
  createdById            String?
  createdBy              User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes                  String?
  createdAt              DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([relatedOrderId])
  @@index([relatedSaleId])
  @@index([relatedPurchaseOrderId])
}

model CustomerLedgerEntry {
  id           String                  @id @default(cuid())
  customerId   String
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         CustomerLedgerEntryType
  amount       Decimal                 @db.Decimal(12, 2)
  balanceAfter Decimal                 @db.Decimal(12, 2)
  saleId       String?
  sale         Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  paymentId    String?
  payment      Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reference    String?
  notes        String?
  createdAt    DateTime                @default(now())

  @@index([customerId, createdAt])
  @@index([saleId])
  @@index([paymentId])
}

model CashRegisterSession {
  id             String            @id @default(cuid())
  sessionNumber  String            @unique
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @default(0) @db.Decimal(12, 2)
  expectedAmount Decimal?          @db.Decimal(12, 2)
  closingAmount  Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  openedById     String?
  openedBy       User?             @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedById     String?
  closedBy       User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  notes          String?
  sales          Sale[]
  movements      CashMovement[]

  @@index([status])
  @@index([openedAt])
}

model CashMovement {
  id            String              @id @default(cuid())
  sessionId     String
  session       CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal             @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  description   String?
  saleId        String?
  sale          Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?               @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@index([saleId])
}

model Supplier {
  id             String            @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model SupplierProduct {
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierSku  String?
  lastCost     Decimal?       @db.Decimal(12, 2)
  leadTimeDays Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@id([supplierId, variantId])
  @@index([variantId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  orderNumber    String              @unique
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         PurchaseOrderStatus @default(DRAFT)
  subtotal       Decimal             @default(0) @db.Decimal(12, 2)
  notes          String?
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          PurchaseOrderItem[]
  stockMovements StockMovement[]
  receipts       InternalReceipt[]

  @@index([supplierId])
  @@index([status, createdAt])
}

model PurchaseOrderItem {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitCost         Decimal        @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([purchaseOrderId])
  @@index([variantId])
}

model InternalReceipt {
  id              String              @id @default(cuid())
  receiptNumber   String              @unique
  type            InternalReceiptType
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleId          String?
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  total           Decimal             @default(0) @db.Decimal(12, 2)
  htmlSnapshot    String?
  metadata        Json?
  createdAt       DateTime            @default(now())

  @@index([type, createdAt])
  @@index([customerId])
  @@index([saleId])
  @@index([purchaseOrderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
